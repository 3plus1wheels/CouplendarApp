SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon/PostgreSQL settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
GOOGLE_PLACES_API_KEY=your_google_places_api_key
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
PLANNER_CHAT_COOLDOWN_SECONDS=6
PLANNER_CHAT_DAILY_USER_LIMIT=40
PLANNER_CHAT_DAILY_GLOBAL_LIMIT=850
PLANNER_CHAT_RESPONSE_CACHE_SECONDS=604800
DISCOVERY_CACHE_SECONDS=300
DISCOVERY_DETAIL_CACHE_SECONDS=600
GOOGLE_SPOT_REINGEST_INTERVAL_SECONDS=300
